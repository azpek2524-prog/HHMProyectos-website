# Copia este archivo como .env.local y llena los valores.
# .env.local no se sube a git.

# --- Cotizaciones por correo (src/lib/mailer.ts) ---
# Cuenta que envía los correos. Con Gmail:
#   1. Activa la verificación en dos pasos en la cuenta.
#   2. Crea una "contraseña de aplicación" en myaccount.google.com/apppasswords
#   3. Pégala en SMTP_PASS (16 caracteres, sin espacios).
SMTP_USER=hhmproyectos@gmail.com
SMTP_PASS=

# Opcionales (por defecto Gmail: smtp.gmail.com, puerto 465).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# A quién llegan las cotizaciones (por defecto el correo de src/lib/site.ts).
# LEADS_TO=hhmproyectos@gmail.com

# --- Testimonios desde Notion (src/lib/testimonials.ts) ---
# 1. En notion.so/profile/integrations crea una integración interna y copia su token.
# 2. En Notion abre "Sitio web · HHM Proyectos" › Testimonios, menú "…" ›
#    Conexiones, y agrega esa integración.
# 3. El ID de la base de testimonios ya está abajo.
# Sin token, el sitio usa los testimonios de src/lib/data.ts (vacío = sección oculta).
NOTION_TOKEN=
NOTION_TESTIMONIOS_ID=7b4d2032-22fe-4e0a-ba28-0fe86acd5036

# --- Sitio ---
# Dominio público, sin "/" al final (canónicas, sitemap y vista previa en redes).
# NEXT_PUBLIC_SITE_URL=https://hhmproyectos.com

# WhatsApp en formato internacional, solo dígitos (por defecto 528123999979).
# NEXT_PUBLIC_WHATSAPP_NUMBER=528123999979
